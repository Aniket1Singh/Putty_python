LOG_FILE_DEFAULT = r"C:\Users\Aniket\OneDrive\Desktop\Terminal log\terminal.log"
READ_POLL_SEC = 0.05
PLOT_REFRESH_MS = 250

single_int_re = re.compile(r"^\s*(\d{7})\s*$")  # exactly 7 digits


def raw_to_emf_mv(raw: int) -> float:
    return (raw / 1000.0) - 1085.0


def fmt_mmss(x, pos):
    x = max(0.0, float(x))
    m = int(x // 60)
    s = int(x % 60)
    return f"{m:02d}:{s:02d}"


def sec_to_mmss(sec: float) -> str:
    sec = max(0.0, float(sec))
    m = int(sec // 60)
    s = int(sec % 60)
    return f"{m:02d}:{s:02d}"


class FileMonitor:
    """
    Tail-like reader + truncate detect.
    When file is cleared/truncated by logger, it signals RESET event.
    """

    def __init__(self):
        self.file_path = None
        self.running = False

        # Stored plotted series:
        self.data_x = []          # time (sec)
        self.data_y = []          # emf (mV)
        self.data_raw = []        # raw int aligned to each point

        self.file_pos = 0
        self.t0 = None

        self.queue = Queue()      # items: (t, raw, emf_mv)
        self.event_q = Queue()    # items: ("RESET", reason)

    def start(self):
        if not self.file_path:
            return
        self.running = True
        self.file_pos = 0
        self.data_x.clear()
        self.data_y.clear()
        self.data_raw.clear()
        self.queue = Queue()
        self.event_q = Queue()
        self.t0 = time.time()
        threading.Thread(target=self.read_loop, daemon=True).start()

    def stop(self):
        self.running = False

    def reset_buffers(self):
        self.data_x.clear()
        self.data_y.clear()
        self.data_raw.clear()
        self.queue = Queue()
        self.t0 = time.time()

    def _parse_line(self, line: str):
        line = line.strip()
        if not line:
            return None

        m = single_int_re.match(line)
        if not m:
            return None

        raw = int(m.group(1))
        t = time.time() - self.t0
        emf_mv = raw_to_emf_mv(raw)
        return (float(t), int(raw), float(emf_mv))

    def read_loop(self):
        while self.running and self.file_path and not os.path.exists(self.file_path):
            time.sleep(READ_POLL_SEC)

        last_size = 0

        while self.running and self.file_path:
            try:
                try:
                    size = os.path.getsize(self.file_path)
                except FileNotFoundError:
                    time.sleep(READ_POLL_SEC)
                    continue

                truncated = (size < self.file_pos) or (size < last_size)
                if truncated:
                    self.file_pos = 0
                    self.event_q.put(("RESET", "File truncated/cleared by logger"))
                last_size = size

                with open(self.file_path, "r", encoding="utf-8", errors="ignore") as f:
                    f.seek(self.file_pos)
                    lines = f.readlines()
                    self.file_pos = f.tell()

                for line in lines:
                    parsed = self._parse_line(line)
                    if parsed is not None:
                        self.queue.put(parsed)

            except Exception as e:
                print("Error reading file:", e)

            time.sleep(READ_POLL_SEC)


class LivePlotterApp:
    def __init__(self, root):
        self.root = root
        self.root.title("MNST Lab Live Plotter (Portable Sensor)")
        self.root.geometry("1250x820")
        self.root.configure(bg="#0B1220")

        self.monitor = FileMonitor()

        # ---------- ttk styling ----------
        style = ttk.Style()
        try:
            style.theme_use("clam")
        except:
            pass

        style.configure("Top.TFrame", background="#0B1220")
        style.configure("Card.TLabelframe", background="#0B1220", foreground="#E5E7EB")
        style.configure("Card.TLabelframe.Label", background="#0B1220", foreground="#E5E7EB")
        style.configure("Top.TLabel", background="#0B1220", foreground="#E5E7EB")
        style.configure("Top.TButton", padding=(10, 6))
        style.configure("Top.TEntry", padding=(6, 4))

        # ---------- Top bar ----------
        top = ttk.Frame(root, style="Top.TFrame", padding=10)
        top.pack(fill=tk.X)

        file_box = ttk.LabelFrame(top, text="Log file", style="Card.TLabelframe", padding=10)
        file_box.pack(side=tk.LEFT, fill=tk.X, expand=True, padx=(0, 10))

        ttk.Button(file_box, text="Load…", style="Top.TButton", command=self.load_file).pack(side=tk.LEFT, padx=4)
        ttk.Button(file_box, text="Default", style="Top.TButton", command=self.use_default).pack(side=tk.LEFT, padx=4)

        self.file_var = tk.StringVar(value="(no file selected)")
        ttk.Label(file_box, textvariable=self.file_var, style="Top.TLabel", width=62).pack(side=tk.LEFT, padx=10)

        ctrl_box = ttk.LabelFrame(top, text="Controls", style="Card.TLabelframe", padding=10)
        ctrl_box.pack(side=tk.LEFT, padx=(0, 10))

        self.status_var = tk.StringVar(value="idle")
        ttk.Button(ctrl_box, text="Start", style="Top.TButton", command=self.start).pack(side=tk.LEFT, padx=4)
        ttk.Button(ctrl_box, text="Stop", style="Top.TButton", command=self.stop).pack(side=tk.LEFT, padx=4)
        ttk.Button(ctrl_box, text="Reset", style="Top.TButton", command=self.manual_reset).pack(side=tk.LEFT, padx=4)

        ttk.Label(ctrl_box, text="Status:", style="Top.TLabel").pack(side=tk.LEFT, padx=(10, 3))
        ttk.Label(ctrl_box, textvariable=self.status_var, style="Top.TLabel").pack(side=tk.LEFT)

        title_box = ttk.LabelFrame(top, text="Graph title", style="Card.TLabelframe", padding=10)
        title_box.pack(side=tk.LEFT)

        self.title_var = tk.StringVar(value="Live EMF")
        ttk.Entry(title_box, textvariable=self.title_var, width=22, style="Top.TEntry").pack(side=tk.LEFT, padx=4)
        ttk.Button(title_box, text="Apply", style="Top.TButton", command=self.apply_title).pack(side=tk.LEFT, padx=4)

        export_box = ttk.LabelFrame(top, text="Export", style="Card.TLabelframe", padding=10)
        export_box.pack(side=tk.LEFT, padx=(10, 0))

        ttk.Button(export_box, text="Export CSV", style="Top.TButton", command=self.export_csv).pack(side=tk.LEFT, padx=4)
        ttk.Button(export_box, text="Save graph", style="Top.TButton", command=self.save_graph).pack(side=tk.LEFT, padx=4)

        # ---------- Options row ----------
        opts = ttk.Frame(root, style="Top.TFrame", padding=(10, 0, 10, 8))
        opts.pack(fill=tk.X)

        self.autoscale_var = tk.BooleanVar(value=True)
        ttk.Checkbutton(opts, text="Auto-scale Y", variable=self.autoscale_var).pack(side=tk.LEFT)

        self.latest_var = tk.StringVar(value="Latest: -- mV")
        ttk.Label(opts, textvariable=self.latest_var, style="Top.TLabel").pack(side=tk.RIGHT)

        self.note_var = tk.StringVar(value="")
        ttk.Label(opts, textvariable=self.note_var, style="Top.TLabel").pack(side=tk.RIGHT, padx=(0, 18))

        # ---------- Plot ----------
        plt.style.use("seaborn-v0_8-whitegrid")

        plot_frame = ttk.Frame(root, padding=(10, 6, 10, 10))
        plot_frame.pack(fill=tk.BOTH, expand=True)

        self.fig, self.ax = plt.subplots(figsize=(11.2, 6.2))
        self.fig.patch.set_facecolor("#F8FAFC")
        self.ax.set_facecolor("#FFFFFF")

        (self.line,) = self.ax.plot([], [], lw=2.0, color="#2563EB")
        self.ax.set_xlabel("Time (mm:ss)")
        self.ax.set_ylabel("EMF (mV)")
        self.ax.xaxis.set_major_formatter(FuncFormatter(fmt_mmss))
        self.ax.set_title(self.title_var.get())

        self.canvas = FigureCanvasTkAgg(self.fig, master=plot_frame)
        self.canvas.get_tk_widget().pack(fill=tk.BOTH, expand=True)

        toolbar_frame = ttk.Frame(root, padding=(10, 0, 10, 10))
        toolbar_frame.pack(fill=tk.X)
        self.toolbar = NavigationToolbar2Tk(self.canvas, toolbar_frame)
        self.toolbar.update()

        self.update_plot()

    # ---------- UI actions ----------
    def apply_title(self):
        t = self.title_var.get().strip() or "Live EMF"
        self.ax.set_title(t)
        self.canvas.draw_idle()

    def use_default(self):
        self.monitor.file_path = LOG_FILE_DEFAULT
        self.file_var.set(self.monitor.file_path)

    def load_file(self):
        path = filedialog.askopenfilename(
            title="Select log file",
            filetypes=[("Log/Text files", "*.log *.txt"), ("All files", "*.*")]
        )
        if path:
            self.monitor.file_path = path
            self.file_var.set(path)

    def start(self):
        if not self.monitor.file_path:
            messagebox.showwarning("No file", "Select a file first (Load… / Default).")
            return
        self.monitor.start()
        self.status_var.set("running")
        self.note_var.set("")

    def stop(self):
        self.monitor.stop()
        self.status_var.set("stopped")

    def manual_reset(self):
        self._reset_plot_ui("Manual reset")

    def export_csv(self):
        if not self.monitor.data_x:
            messagebox.showinfo("No data", "No data to export yet.")
            return

        default_name = f"emf_export_{datetime.now().strftime('%Y%m%d_%H%M%S')}.csv"
        out_path = filedialog.asksaveasfilename(
            title="Save CSV (Excel)",
            defaultextension=".csv",
            initialfile=default_name,
            filetypes=[("CSV (Excel)", "*.csv")]
        )
        if not out_path:
            return

        try:
            with open(out_path, "w", newline="", encoding="utf-8") as f:
                w = csv.writer(f)  # Excel-friendly CSV [web:226]
                w.writerow(["time_sec", "time_mmss", "raw", "emf_mv"])
                for t, raw, emf in zip(self.monitor.data_x, self.monitor.data_raw, self.monitor.data_y):
                    w.writerow([f"{t:.3f}", sec_to_mmss(t), raw, f"{emf:.6f}"])
            self.note_var.set(f"Saved CSV: {os.path.basename(out_path)}")
        except Exception as e:
            messagebox.showerror("Export failed", str(e))

    def save_graph(self):
        default_name = f"emf_plot_{datetime.now().strftime('%Y%m%d_%H%M%S')}.png"
        out_path = filedialog.asksaveasfilename(
            title="Save graph image",
            defaultextension=".png",
            initialfile=default_name,
            filetypes=[("PNG image", "*.png"), ("PDF (vector)", "*.pdf"), ("SVG (vector)", "*.svg")]
        )
        if not out_path:
            return

        try:
            # High-quality export; PDF/SVG preserves sharp zoom in viewers [web:225]
            self.fig.savefig(out_path, dpi=300, bbox_inches="tight")
            self.note_var.set(f"Saved graph: {os.path.basename(out_path)}")
        except Exception as e:
            messagebox.showerror("Save failed", str(e))

    # ---------- Internal helpers ----------
    def _reset_plot_ui(self, reason: str):
        self.monitor.reset_buffers()
        self.line.set_data([], [])
        self.ax.relim()
        self.ax.autoscale_view()
        self.latest_var.set("Latest: -- mV")
        self.note_var.set(f"Reset: {reason}")
        self.canvas.draw_idle()

    def _handle_monitor_events(self):
        while True:
            try:
                ev, reason = self.monitor.event_q.get_nowait()
            except Empty:
                break

            if ev == "RESET":
                self._reset_plot_ui(reason)

    def update_plot(self):
        self._handle_monitor_events()

        got = 0
        last_y = None

        while True:
            try:
                t, raw, emf = self.monitor.queue.get_nowait()
            except Empty:
                break
            self.monitor.data_x.append(t)
            self.monitor.data_raw.append(raw)
            self.monitor.data_y.append(emf)
            last_y = emf
            got += 1

        if got > 0:
            self.line.set_data(self.monitor.data_x, self.monitor.data_y)

            if self.autoscale_var.get():
                self.ax.relim()
                self.ax.autoscale_view()

            if last_y is not None:
                self.latest_var.set(f"Latest: {last_y:.3f} mV")

            self.canvas.draw_idle()

        self.root.after(PLOT_REFRESH_MS, self.update_plot)


if __name__ == "__main__":
    root = tk.Tk()
    app = LivePlotterApp(root)
    root.mainloop()
